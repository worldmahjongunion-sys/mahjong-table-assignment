# Dockerで動かすときの設定の見本。このファイルを .env という名前でコピーして値を入れる。
# .env は .gitignore と .dockerignore に入っているので、GitHubにも箱にも入らない。
#   docker run --env-file .env ...
# 項目の意味は .streamlit/secrets.toml.example と同じ。

AUTH_COOKIE_NAME=mahjong_kumi_auth
# python -c "import secrets; print(secrets.token_hex(32))" で作った長い文字列
AUTH_COOKIE_KEY=
# サインアップ画面で要求する招待コード（合言葉）
AUTH_INVITE_CODE=
APP_BASE_URL=http://localhost:8501

# 任意（設定しない場合、メールは送られず画面とログに表示される）
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_FROM=

# 任意（設定しない場合、webhook_server.py だけが起動時に止まる。卓組み画面はそのまま動く）
# STRIPE_WEBHOOK_SECRET=
