[auth]
cookie_name = "mahjong_kumi_auth"
cookie_key = "ここにランダムな長い文字列を入れる（例: python3 -c 'import secrets; print(secrets.token_hex(32))'）"
invite_code = "サインアップ画面で要求する招待コード（合言葉）をここに設定"

# 以下は任意設定。app_base_url は確認メール・パスワード再設定メール・招待リンクの
# URLの組み立てに使う（本番ではデプロイ先のURLを設定する）。
# smtp_* を設定しない場合、メールは実際には送信されず、開発用に画面とコンソールに表示される。
app_base_url = "http://localhost:8501"
# smtp_host = "smtp.example.com"
# smtp_port = "587"
# smtp_user = "your-account@example.com"
# smtp_password = "アプリパスワードなど"
# smtp_from = "your-account@example.com"

# Stripe（Proプランへのアップグレード決済）。必ずテストモードのキーを使うこと。
# 未設定の場合、アップグレードボタンは「準備中」と表示され機能しない。
# stripe_secret_key = "sk_test_..."
# stripe_price_id_pro は stripe_setup.py 実行後に表示される price_id を設定する
# stripe_price_id_pro = "price_..."
